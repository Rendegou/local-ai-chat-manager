{
  "name": "local-ai-chat-manager",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Local-first AI coding chat history manager (Tauri 2 + React + TypeScript)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "ui:demo": "python tools/make_demo_data.py .ui-shots/demo --sessions 26 --days 10",
    "ui:mock": "python tools/export_ui_mock.py .ui-shots/demo-index .ui-shots/mock/data.json",
    "ui:shots": "node tools/ui_shot.mjs --out .ui-shots/latest",
    "ui:qa": "node tools/ui_qa.mjs",
    "ui:a11y": "node tools/ui_shot.mjs --out .ui-shots/a11y --pages conversations,search,sync,settings --a11y true"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-opener": "^2.2.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "puppeteer-core": "^25.11.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
